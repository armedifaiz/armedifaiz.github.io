{
  "name": "faizarm-portfolio-site",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "portfolio.faizarmedi.com/*",
      "zone_name": "faizarmedi.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PORTFOLIO_BACKEND_BASE_URL": "https://portfolio-backend.armedifaiz.workers.dev"
  }
}
