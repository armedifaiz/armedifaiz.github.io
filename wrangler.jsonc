{
  "name": "faizarmedi-portfolio-site",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "single-page-app"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PORTFOLIO_BACKEND_BASE_URL": "https://portfolio-backend.armedifaiz.workers.dev"
  }
}

